# ────────────────────────────────────────────────────────────────────────────
# zi-pay — Production Environment (Coolify)
# https://pay.zipremiumservices.com
#
# This file is a TEMPLATE. Copy these keys into Coolify's "Environment
# Variables" panel (or into a real .env) and fill in real values.
# NEVER commit real secrets.
# ────────────────────────────────────────────────────────────────────────────

# ── Build-time (Vite frontend bundle) ──────────────────────────────────────
VITE_API_URL=https://pay.zipremiumservices.com/api
VITE_SOCKET_URL=https://pay.zipremiumservices.com
VITE_MAIN_SITE_URL=https://zipremiumservices.com
VITE_GOOGLE_CLIENT_ID=29298885024-ko5tlfqq9r49dbg11as2aqm5vorbi951.apps.googleusercontent.com

# ── Backend runtime ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
BASE_URL=https://pay.zipremiumservices.com/api

# MongoDB — REQUIRED. Either an Atlas URI, or the local compose mongo service.
# Local compose (default in docker-compose.yml when unset):
#   mongodb://zipay:<password>@mongo:27017/zipay?authSource=admin
# Atlas example:
#   MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/zipay
MONGODB_URI=

# JWT — REQUIRED. Generate:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Webhook HMAC secret — REQUIRED. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SIGNING_SECRET=

# CORS
FRONTEND_URL=https://pay.zipremiumservices.com
CORS_ORIGINS=https://pay.zipremiumservices.com,https://zipremiumservices.com,https://www.zipremiumservices.com

# ── MongoDB container (only used when NOT using Atlas) ─────────────────────
MONGO_INITDB_ROOT_USERNAME=zipay
MONGO_INITDB_ROOT_PASSWORD=change-me-to-a-strong-password