# ── ZiPAY Gateway Backend — Development ──
# For local development only. Production values are in docker-compose.yml / Coolify env.

PORT=3001
NODE_ENV=development

# MongoDB (local dev)
MONGODB_URI=mongodb://127.0.0.1:27017/zipay

# JWT — generate a random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=dev-only-jwt-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend URL (used for CORS origin and cookie/redirect config)
FRONTEND_URL=http://localhost:5173

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Webhook signing secret
WEBHOOK_SIGNING_SECRET=dev-only-webhook-secret

# Google OAuth (admin login verification)
GOOGLE_CLIENT_ID=