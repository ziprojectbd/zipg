# ── ZiPAY Gateway Backend (pay.zipremiumservices.com) — Production ──

PORT=3001
NODE_ENV=production

# MongoDB
MONGODB_URI=mongodb+srv://mdzikrulislamjuwel_db_user:Yc6Us5gSGs7b6scZ@cluster0.fnzzlie.mongodb.net/zipay?appName=Cluster0

# JWT — IMPORTANT: generate your own secret before deploying!
# e.g. node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-very-long-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend URL — used for CORS allowed origin and cookie/redirect config
FRONTEND_URL=https://pay.zipremiumservices.com

# CORS — allow main website + own domain
# The gateway frontend (pay.zipremiumservices.com) is same-origin so is implicit,
# but listing it explicitly covers Socket.IO and any cross-subdomain edge cases.
CORS_ORIGINS=https://pay.zipremiumservices.com,https://zipremiumservices.com,https://www.zipremiumservices.com

# Webhook signing secret — generate a unique secret for HMAC-signed webhook payloads
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SIGNING_SECRET=your-very-long-random-webhook-secret

# Google OAuth (admin login verification)
GOOGLE_CLIENT_ID=29298885024-ko5tlfqq9r49dbg11as2aqm5vorbi951.apps.googleusercontent.com
