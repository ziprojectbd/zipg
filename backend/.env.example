# ── ZiPAY Gateway Backend ──

PORT=3001
NODE_ENV=development

# MongoDB
MONGODB_URI=

# JWT
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend URL (used for CORS origin and cookie/redirect config)
FRONTEND_URL=http://localhost:5173

# CORS (comma-separated allowed origins)
CORS_ORIGINS=

# Webhook signing secret
WEBHOOK_SIGNING_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=




# ── ZiPAY Gateway Backend ──

PORT=3001
NODE_ENV=production

# MongoDB
MONGODB_URI=your_production_mongodb_uri

# JWT
JWT_SECRET=your_64_character_random_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Gateway Frontend
FRONTEND_URL=https://pay.zipremiumservices.com

# CORS
CORS_ORIGINS=https://pay.zipremiumservices.com,https://zipremiumservices.com,https://www.zipremiumservices.com

# Webhook
WEBHOOK_SIGNING_SECRET=your_32_character_random_secret

# Google OAuth
GOOGLE_CLIENT_ID=29298885024-ko5tlfqq9r49dbg11as2aqm5vorbi951.apps.googleusercontent.com