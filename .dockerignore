# ─── Dependencies ───
node_modules/
**/node_modules/

# ─── Build outputs ───
dist/
**/dist/
build/
coverage/
*.tsbuildinfo

# ─── Environment / secrets (NEVER baked into images) ───
.env
.env.*
!.env.example
!.env.*.example
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# ─── v0 / Next.js dead artifacts (not part of the app) ───
# Root-anchored with / so they ONLY match the root-level dirs, not
# frontend/src/** or frontend/public/**.
/app/
/components/
/lib/
/public/
/next.config.mjs
/components.json
/vercel.json
yarn.lock

# ─── Git / IDE ───
.git/
.gitignore
.vscode/
.idea/

# ─── Logs ───
*.log
npm-debug.log*
yarn-debug.log*

# ─── Misc ───
.DS_Store
Thumbs.db
*.md
# keep the deployment docs notes out of the build